    <!-- ══════════ 凭据编辑 ══════════ -->
    <string name="credential_configured_cookies">✓ 已配置登录态（%1$d 个 Cookie）</string>
    <string name="help_cookie_title">如何获取 Cookie？</string>
    <string name="help_cookie_1">1. 在桌面 Chrome 打开下方登录入口</string>
    <string name="help_cookie_2">2. 用 GitHub / Google 登录（不会被拦截）</string>
    <string name="help_cookie_3">3. 登录后按 F12 → Application → Cookies</string>
    <string name="help_cookie_4">4. 复制该站点下的所有 Cookie 粘贴到上面输入框</string>
    <string name="help_cookie_5">格式：name1=value1; name2=value2</string>
    <string name="help_ocgo_title">如何获取 OpenCode Go 凭据？</string>
    <string name="help_ocgo_1">1. 桌面 Chrome 打开 opencode.ai/auth</string>
    <string name="help_ocgo_2">2. 用 GitHub / Google 登录（Google 不会拦截 Chrome）</string>
    <string name="help_ocgo_3">3. 登录后跳转到 dashboard，URL 形如：</string>
    <string name="help_ocgo_4">   https://opencode.ai/workspace/{id}/go</string>
    <string name="help_ocgo_5">4. 复制 URL 中的 {id} 段 → workspaceId</string>
    <string name="help_ocgo_6">5. F12 → Application → Cookies</string>
    <string name="help_ocgo_7">6. 找到域名 opencode.ai 下名为 auth 的 Cookie</string>
    <string name="help_ocgo_8">7. 复制它的 Value 字段 → auth cookie</string>
    <string name="help_ocgo_note">注意：只填 auth 一个 Cookie 即可，不要整个 Cookie 字符串</string>
    <string name="help_ccgo_title">如何获取 CommandCode Go 凭据？</string>
    <string name="help_ccgo_1">1. 打开 https://commandcode.ai 并登录 GitHub</string>
    <string name="help_ccgo_2">▸ 获取 API Key（必填）：</string>
    <string name="help_ccgo_3">   右上角头像 → Settings → API Keys → 创建一个 Key</string>
    <string name="help_ccgo_4">▸ 获取全部 Cookie（用于用量记录）：</string>
    <string name="help_ccgo_5">   F12 → Application → Cookies → commandcode.ai</string>
    <string name="help_ccgo_6">   选中所有 Cookie，复制整个 Cookie 字符串</string>
    <string name="help_ccgo_7">   粘贴到下方输入框即可，无需逐个挑选</string>
    <string name="help_ccgo_note">提示：不填 Cookie 也能正常查看余额，只是用量记录为空。</string>
    <string name="help_codex_title">如何获取 Codex auth.json？</string>
    <string name="help_codex_1">1. 在终端运行 codex-oauth-proxy 或</string>
    <string name="help_codex_2">   codex-proxy，完成 ChatGPT 登录</string>
    <string name="help_codex_3">2. 凭证文件保存在：</string>

